{
  "manifest_version": 3,
  "name": "SwiftHarryDM Downloader",
  "version": "1.0.0",
  "description": "Download videos and audio with SwiftHarryDM",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SwiftHarryDM",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["icons/download-icon.png"],
    "matches": ["<all_urls>"]
  }]
}