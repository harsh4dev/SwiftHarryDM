{
  "manifest_version": 3,
  "name": "SwiftHarryDM Helper",
  "version": "1.0",
  "description": "Capture video links and send to SwiftHarryDM desktop app.",
  "permissions": [
    "downloads",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "SwiftHarryDM",
    "default_popup": "popup.html"
  }
}
